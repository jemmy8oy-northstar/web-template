<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Roslyn incremental source generator that materialises the trivial concrete
    half of the interface-only-in-abstractions pattern (web-template#79).
    Targets netstandard2.0 because analyzers/source generators load into the
    compiler, which runs on that TFM. Referenced by consuming projects with
    OutputItemType="Analyzer" (see SolutionName.DataModels.csproj).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
